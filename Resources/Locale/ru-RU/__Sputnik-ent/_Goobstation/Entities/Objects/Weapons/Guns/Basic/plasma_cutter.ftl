ent-WeaponPlasmaCutter = фороновый резак
    .desc = Оружие для самообороны, изматывающее органические цели и ослабляющее их до тех пор, пока те не рухнут. Фороновые заряды делают его превосходным для добычи полезных ископаемых.

ent-WeaponPlasmaCutterEmpty = { ent-WeaponPlasmaCutter }
    .suffix = Пустой
    .desc = { ent-WeaponPlasmaCutter.desc }
